+void register_interrupts(HleRegistrar &hle) {
+    hle.add("InterruptManager", "sceKernelRegisterSubIntrHandler", [](Runtime &, AllegrexContext &ctx) {
+        auto &handler = kernel().sub_interrupts[arg(ctx, 0)][arg(ctx, 1)];
