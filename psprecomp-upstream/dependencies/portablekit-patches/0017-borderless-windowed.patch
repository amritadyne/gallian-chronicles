-    if (!impl_ || impl_->window == nullptr) return;
+    set_display_mode(fullscreen ? settings::DisplayMode::Fullscreen : settings::DisplayMode::Window);
+}
+
+void VulkanRenderer::set_display_mode(settings::DisplayMode mode) {
+    if (impl_ && impl_->window != nullptr) impl_->apply_display_mode(mode);
+}
+
+void VulkanRenderer::Impl::apply_display_mode(settings::DisplayMode mode) {
 #if defined(__ANDROID__)
-    fullscreen = true;
+    mode = settings::DisplayMode::Fullscreen;
 #endif
-    SDL_SetWindowFullscreen(impl_->window, fullscreen);
-    impl_->swapchain_dirty = true;
+    using settings::DisplayMode;
+    if (display_mode == DisplayMode::Window && mode != DisplayMode::Window) {
+        // Remember the plain window's place and size, unmaximised.
+        if ((SDL_GetWindowFlags(window) & SDL_WINDOW_MAXIMIZED) != 0u) {
+            SDL_RestoreWindow(window);
+            SDL_SyncWindow(window);
+        }
+        windowed_rect_known = SDL_GetWindowPosition(window, &windowed_rect.x, &windowed_rect.y) &&
+                              SDL_GetWindowSize(window, &windowed_rect.w, &windowed_rect.h);
+    }
+    const DisplayMode previous = display_mode;
+    display_mode = mode;
+    switch (mode) {
+    case DisplayMode::Fullscreen:
+        SDL_SetWindowBordered(window, true);
+        SDL_SetWindowResizable(window, true);
+        SDL_SetWindowFullscreen(window, true);
+        break;
+    case DisplayMode::Borderless:
+        SDL_SetWindowFullscreen(window, false);
+        SDL_SyncWindow(window);
+        SDL_SetWindowResizable(window, false);
+        SDL_SetWindowBordered(window, false);
+        cover_display();
+        break;
+    case DisplayMode::Window:
+        SDL_SetWindowFullscreen(window, false);
+        SDL_SyncWindow(window);
+        SDL_SetWindowBordered(window, true);
+        SDL_SetWindowResizable(window, true);
+        if (previous != DisplayMode::Window && windowed_rect_known && windowed_rect.w > 0 && windowed_rect.h > 0) {
+            SDL_SetWindowSize(window, windowed_rect.w, windowed_rect.h);
+            SDL_SetWindowPosition(window, windowed_rect.x, windowed_rect.y);
+        }
+        break;
+    }
+    SDL_SyncWindow(window);
+    swapchain_dirty = true;
+    std::cout << "[render] display mode "
+              << (mode == DisplayMode::Fullscreen ? "fullscreen" : mode == DisplayMode::Borderless ? "borderless" : "window")
+              << "\n";
+}
+
+void VulkanRenderer::Impl::cover_display() {
+    if (window == nullptr) return;
+    SDL_DisplayID display = SDL_GetDisplayForWindow(window);
+    if (display == 0u) display = SDL_GetPrimaryDisplay();
+    SDL_Rect bounds{};
+    if (display == 0u || !SDL_GetDisplayBounds(display, &bounds) || bounds.w <= 0 || bounds.h <= 0) return;
+    int x = 0, y = 0, width = 0, height = 0;
+    SDL_GetWindowPosition(window, &x, &y);
+    SDL_GetWindowSize(window, &width, &height);
+    if (x == bounds.x && y == bounds.y && width == bounds.w && height == bounds.h) return;
+    SDL_SetWindowPosition(window, bounds.x, bounds.y);
+    SDL_SetWindowSize(window, bounds.w, bounds.h);
+    swapchain_dirty = true;
 }
 
