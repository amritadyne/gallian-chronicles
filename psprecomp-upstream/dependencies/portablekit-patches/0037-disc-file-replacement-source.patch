+// A source of replacement contents for files on the disc (Gallian Chronicles
+// patch 0037). At every open of a disc file (not a directory or the raw
+// device) the source is asked with the file's path on the disc, as the disc
+// spells it relative to its root (e.g. "PSP_GAME/USRDIR/STREAM/OD_VOICE.AFS"),
+// its size and a reader of its own bytes; a filter it returns is what the game
+// reads instead, as with set_file_filter. Null: the file's own bytes. Called on
+// the emulation thread. An empty source removes it.
+using DiscFileReader = std::function<std::size_t(std::uint64_t offset, std::uint8_t *destination, std::size_t length)>;
+using DiscFileSource =
+    std::function<std::shared_ptr<FileFilter>(const std::string &path, std::uint64_t size, DiscFileReader original)>;
+void set_disc_file_source(DiscFileSource source);
+
 } // namespace portablekit::hle_extension
 
