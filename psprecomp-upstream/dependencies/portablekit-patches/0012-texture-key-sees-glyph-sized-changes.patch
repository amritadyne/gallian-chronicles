diff -ru a/host/gpu/texture_decode.cpp b/host/gpu/texture_decode.cpp
--- a/host/gpu/texture_decode.cpp	2026-11-07 12:22:44.954701749 +0000
+++ b/host/gpu/texture_decode.cpp	2026-11-07 12:24:13.154812591 +0000
@@ -469,8 +469,16 @@
 }
 
 // Textures up to this size are keyed by all of their contents, larger ones by
-// one word in every 256 bytes.
-constexpr std::uint32_t kFullKeyBytes = 64u * 1024u;
+// one word in every kSampleStride bytes. Games build glyph and icon sheets
+// one entry at a time: VC2's 256x256 32-bit sheet of special characters
+// (256 KB) gains a 16x16 button icon in a corner when a tutorial needs it. With
+// a full key only up to 64 KB and a word every 256 bytes, each 1024-byte row
+// was sampled at columns 0, 64, 128 and 192, the icon (columns 208-223) never,
+// so the cached copy without it kept being drawn. Whole up to 256 KB, and a
+// word every 64 bytes above (every 16th texel at 32 bits), so a glyph-sized
+// change is always seen. Each texture is keyed once per display list.
+constexpr std::uint32_t kFullKeyBytes = 256u * 1024u;
+constexpr std::uint32_t kSampleStride = 64u;
 
 std::uint64_t texture_key(const GuestMemory &memory, const TextureState &texture) {
     // Address, layout and a sample of the contents: guest textures are often
@@ -522,14 +530,14 @@
             for (const std::uint64_t lane : lanes) mix(lane);
             for (; offset < size; ++offset) mix(data[offset]);
         } else {
-            for (std::uint32_t offset = 0; offset < size; offset += 256u) {
+            for (std::uint32_t offset = 0; offset < size; offset += kSampleStride) {
                 std::uint32_t word{};
                 std::memcpy(&word, data + offset, sizeof(word));
                 mix(word);
             }
         }
     } else {
-        for (std::uint32_t offset = 0; offset < size; offset += 256u) {
+        for (std::uint32_t offset = 0; offset < size; offset += kSampleStride) {
             if (!memory.contains(texture.address + offset, 4u)) break;
             mix(memory.load32(texture.address + offset));
         }
