+// Rows a texture occupies in memory: a swizzled one is stored as whole blocks
+// 8 rows tall. Its bytes per row likewise round up to whole 16-byte blocks: a
+// buffer narrower than one block (a 16-texel 4-bit texture has 8-byte rows)
+// still takes a block per row on hardware. Left unswizzled, such a texture
+// was read as plain rows and came out as stripes.
+std::uint32_t stored_row_bytes(const TextureState &texture, std::uint32_t row_bytes) {
+    return texture.swizzled ? (row_bytes + 15u) & ~15u : row_bytes;
+}
+std::uint32_t stored_rows(const TextureState &texture, std::uint32_t rows) {
+    return texture.swizzled ? (rows + 7u) & ~7u : rows;
+}
