-std::unique_ptr<TexturePack> TexturePack::parse(const std::filesystem::path &directory, const std::string &game_id,
+namespace {
+// A pack as PPSSPP lays it out (PSP/TEXTURES/<game id>/textures.ini), chosen
+// one or two folders up (TEXTURES, or PSP): the folder for this game inside
+// it. That is a folder named after the game id, else one whose textures.ini
+// names the game in [games], else the only folder with a textures.ini. The
+// folder itself when it has its own textures.ini (or none of these is found).
+std::filesystem::path pack_folder(const std::filesystem::path &directory, const std::string &game_id) {
+    std::error_code ec;
+    if (std::filesystem::exists(directory / "textures.ini", ec)) return directory;
+    std::vector<std::filesystem::path> with_ini;
+    const auto look = [&](const std::filesystem::path &folder) {
+        for (const auto &entry : std::filesystem::directory_iterator(folder, ec))
+            if (entry.is_directory(ec) && std::filesystem::exists(entry.path() / "textures.ini", ec))
+                with_ini.push_back(entry.path());
+    };
+    look(directory);
+    for (const auto &entry : std::filesystem::directory_iterator(directory, ec))
+        if (entry.is_directory(ec)) look(entry.path());
+    for (const std::filesystem::path &folder : with_ini)
+        if (!game_id.empty() && lower(folder.filename().string()) == lower(game_id)) return folder;
+    for (const std::filesystem::path &folder : with_ini) {
+        const std::vector<std::string> games = texture_pack_games(folder / "textures.ini");
+        if (std::find(games.begin(), games.end(), game_id) != games.end()) return folder;
+    }
+    return with_ini.size() == 1u ? with_ini.front() : directory;
+}
