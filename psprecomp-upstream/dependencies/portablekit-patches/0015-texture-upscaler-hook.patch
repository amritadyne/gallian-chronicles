Subject: [PATCH 0015] Texture upscaler hook for game profiles

A game profile may claim textures and give the renderer a more detailed
image, a whole number of times larger (VC2: its glyph texture redrawn as
smooth outlines for high-resolution text). gpu::set_texture_upscaler().

diff -ru a/host/gpu/ge_state.cpp b/host/gpu/ge_state.cpp
--- a/host/gpu/ge_state.cpp	2026-11-07 18:44:58.554981671 +0000
+++ b/host/gpu/ge_state.cpp	2026-11-07 18:44:58.556565870 +0000
@@ -990,6 +990,11 @@
 
 void set_draw_observer(DrawObserver observer) noexcept { g_draw_observer = observer; }
 void set_native_draw_source(NativeDrawSource source) noexcept { g_native_draw_source = source; }
+namespace {
+TextureUpscaler g_texture_upscaler = nullptr;
+}
+void set_texture_upscaler(TextureUpscaler upscaler) noexcept { g_texture_upscaler = upscaler; }
+TextureUpscaler texture_upscaler() noexcept { return g_texture_upscaler; }
 
 void GeState::fill_draw_state(DrawCall &call) const {
     call.through = (vertex_type_ & (1u << 23u)) != 0u;
diff -ru a/host/gpu/ge_state.hpp b/host/gpu/ge_state.hpp
--- a/host/gpu/ge_state.hpp	2026-11-07 18:44:58.552075680 +0000
+++ b/host/gpu/ge_state.hpp	2026-11-07 18:44:58.553569155 +0000
@@ -274,6 +274,18 @@
 using NativeDrawSource = const DrawCall *(*)(std::uint32_t marker);
 void set_native_draw_source(NativeDrawSource source) noexcept;
 
+// Optional source of more detailed images for some of the game's textures. The
+// renderer asks it about every texture it creates, first with texels null:
+// true claims the texture (it is then decoded at once, not in the background).
+// Then it is given the decoded texels (width x height, RGBA) and the scale the
+// render target would use (its height / 272, rounded up) and returns an image
+// `scale` times as wide and tall in `out`, or false to keep the original. A
+// game profile uses it to draw text in high resolution (VC2's glyph texture).
+using TextureUpscaler = bool (*)(const TextureState &texture, const std::uint32_t *texels,
+                                 std::uint32_t wanted_scale, std::vector<std::uint32_t> &out, std::uint32_t &scale);
+void set_texture_upscaler(TextureUpscaler upscaler) noexcept;
+[[nodiscard]] TextureUpscaler texture_upscaler() noexcept;
+
 // Executes display lists and reports the draw calls they produce. The backend
 // installs a sink; with no sink the lists are still parsed (for callbacks).
 class GeState {
