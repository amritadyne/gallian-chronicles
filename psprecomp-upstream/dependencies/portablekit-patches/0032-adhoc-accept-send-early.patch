 constexpr std::size_t kMaxQueuedOutput = 512u * 1024u;
+// The most a stream queues for sending, whatever buffer size the game gave it.
+// On the PSP a stream's sends leave for the network as they are made, so a
+// game can send more in one go than its buffer holds (VC2's battle setup
+// sends about 18 KB on an 8 KB stream, and drops what does not go).
+constexpr std::size_t kStreamSendRoom = 256u * 1024u;
 constexpr std::size_t kReadChunk = 16u * 1024u;
 
